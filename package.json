{
  "name": "cupertino-icons-svg",
  "version": "0.1.0",
  "description": "Cupertino Icons (Apple-style SF Symbols) as individual SVG files for web and JS bundlers.",
  "license": "MIT",
  "author": "Ayuka Badma-Garyaev",
  "repository": {
    "type": "git",
    "url": ""
  },
  "homepage": "",
  "bugs": {
    "url": ""
  },
  "keywords": [
    "cupertino",
    "icons",
    "svg",
    "apple",
    "sf-symbols",
    "flutter",
    "web",
    "icon-pack"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "svg/",
    "icons/",
    "index.js",
    "index.d.ts",
    "icons.json",
    "README.md",
    "LICENSE",
